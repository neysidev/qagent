{
  "name": "qagent",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "convex": "cd apps/web && npx convex dev",
    "typecheck": "pnpm -r typecheck",
    "worker": "cd apps/worker && .venv/bin/python -m qagent_worker.main",
    "dev": "concurrently -n web,convex,worker -c blue,magenta,yellow \"pnpm dev:web\" \"pnpm convex\" \"pnpm worker\""
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
